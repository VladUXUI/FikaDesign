# Contact form delivery (Gmail SMTP) — set these in Vercel → Project → Settings →
# Environment Variables, and locally in .env.local (gitignored).
# Without them the form shows a graceful "email us directly" message.

# The Gmail address that sends the mail
GMAIL_USER=

# A Google App Password (16 chars, no spaces) — requires 2-Step Verification.
# Generate at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
